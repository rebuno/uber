{
  "name": "uber",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env agent/main.ts",
    "tui": "tsx --env-file-if-exists=.env tui/main.ts",
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p sandboxes",
    "test": "node --import tsx --test \"agent/**/*.test.ts\"",
    "lint": "biome check",
    "format": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@daytonaio/sdk": "^0.222.0",
    "@types/node": "^26.0.0",
    "@vercel/sandbox": "^3.5.1",
    "e2b": "^2.52.0",
    "modal": "^0.11.0",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
